{
  "manifest_version": 3,
  "name": "Vinted Discord Alerts",
  "version": "1.0.0",
  "description": "Envoie les annonces visibles vers ton bot Discord.",
  "permissions": [],
  "host_permissions": [
    "https://www.vinted.fr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
