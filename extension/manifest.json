{
  "manifest_version": 3,
  "name": "Vinted Discord Alerts",
  "version": "1.0.3",
  "description": "Scanne manuellement les annonces Vinted visibles et les envoie sur demande à Discord.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://kiqnfbglxp.apps.bot-hosting.cloud/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.fr/*",
        "https://*.vinted.be/*",
        "https://*.vinted.de/*",
        "https://*.vinted.es/*",
        "https://*.vinted.it/*",
        "https://*.vinted.pt/*",
        "https://*.vinted.lu/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
